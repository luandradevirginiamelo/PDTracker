<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgroud"
    tools:context=".Create_Update_PProfile">


    <ImageView
        android:id="@+id/logo"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <TextView
        android:id="@+id/title_Create_Update_Patient_Profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="@string/title_CUPP"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt_save"
        style="@style/Button2"
        android:text="Save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/ContainerComponents"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt_bdb"
        style="@style/Button2"
        android:text="Back to dashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/bt_save"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ContainerComponents"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/title_Create_Update_Patient_Profile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <EditText
            android:id="@+id/Patient_Hight"
            style="@style/Edit_Text2"
            android:layout_width="280dp"
            android:layout_height="40dp"
            android:hint="Patient Hight (cm):"
            android:inputType="text"
            android:visibility="visible"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Hight (cm):"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/Patient_Hight"
            app:layout_constraintStart_toStartOf="@id/Patient_Hight" />


        <EditText
            android:id="@+id/Patient_weight"
            style="@style/Edit_Text2"
            android:layout_width="280dp"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:hint="Patient Weight (kg):"
            android:inputType="numberDecimal"
            app:layout_constraintStart_toStartOf="@id/Patient_Hight"
            app:layout_constraintTop_toBottomOf="@id/Patient_Hight" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weight must be between 40kg and 150kg"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/Patient_weight"
            app:layout_constraintStart_toStartOf="@id/Patient_weight" />

        <EditText
            android:id="@+id/Patient_heart"
            style="@style/Edit_Text2"
            android:layout_width="280dp"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:hint="Normal Heart Rate(bpm)"
            android:inputType="number"
            app:layout_constraintStart_toStartOf="@+id/Patient_weight"
            app:layout_constraintTop_toBottomOf="@+id/Patient_weight" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Heart Rate ranges from 60-100 at rest"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/Patient_heart"
            app:layout_constraintStart_toStartOf="@id/Patient_heart" />


        <EditText
            android:id="@+id/threshold_hr"
            style="@style/Edit_Text2"
            android:layout_width="280dp"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:hint="Threshold Heart Rate (bpm)"
            android:inputType="number"
            app:layout_constraintStart_toStartOf="@+id/Patient_heart"
            app:layout_constraintTop_toBottomOf="@+id/Patient_heart" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Threshould Rate ranges more than 180"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/threshold_hr"
            app:layout_constraintStart_toStartOf="@id/threshold_hr" />


        <EditText
            android:id="@+id/Nbloodpre"
            style="@style/Edit_Text2"
            android:layout_width="280dp"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:hint="Normal Blood Pressure"
            android:inputType="number"
            app:layout_constraintStart_toStartOf="@+id/threshold_hr"
            app:layout_constraintTop_toBottomOf="@+id/threshold_hr" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Normal Blood pressure (less than 130 mm Hg)"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/Nbloodpre"
            app:layout_constraintStart_toStartOf="@id/Nbloodpre" />


        <EditText
            android:id="@+id/threshold_bloodpre"
            style="@style/Edit_Text2"
            android:layout_width="280dp"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:hint="Threshold Blood Pressure"
            android:inputType="number"
            app:layout_constraintStart_toStartOf="@+id/Nbloodpre"
            app:layout_constraintTop_toBottomOf="@+id/Nbloodpre" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Threshold Blood pressure high/130-139 mm Hg"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/threshold_bloodpre"
            app:layout_constraintStart_toStartOf="@id/threshold_bloodpre" />



    <EditText
        android:id="@+id/Smartw_ID"
        style="@style/Edit_Text2"
        android:layout_width="280dp"
        android:layout_height="40dp"
        android:layout_marginTop="18dp"
        android:hint="SmartWatch ID"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="@+id/threshold_bloodpre"
        app:layout_constraintTop_toBottomOf="@+id/threshold_bloodpre" />



        <EditText
            android:id="@+id/Smart_name"
            style="@style/Edit_Text2"
            android:layout_width="280dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:hint="SmartWatch Name"
            android:inputType="text"
            app:layout_constraintStart_toStartOf="@+id/Smartw_ID"
            app:layout_constraintTop_toBottomOf="@+id/Smartw_ID" />

    <EditText
        android:id="@+id/Smartwatch_model"
        style="@style/Edit_Text2"
        android:layout_width="280dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:hint="SmartWatch Model"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="@+id/Smart_name"
        app:layout_constraintTop_toBottomOf="@+id/Smart_name" />






</androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>