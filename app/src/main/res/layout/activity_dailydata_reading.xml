<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Dailydata_reading">


    <ImageView
        android:id="@+id/logo"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <TextView
        android:id="@+id/title_dailydata"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Daily data from smart watch"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt_bdb"
        style="@style/Button2"
        android:text="Back to dashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/ContainerComponents"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ContainerComponents"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/title_dailydata"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <TextView
            android:id="@+id/currentheart_rate"
            android:textStyle="bold"
            android:layout_width="250dp"
            android:layout_height="40dp"
            android:visibility="visible"
            android:hint="Current Heart rate"
            android:inputType="text"
            />


        <TextView
            android:id="@+id/Mood_rate"
            android:textStyle="bold"
            android:layout_width="250dp"
            android:layout_height="40dp"
            android:layout_marginTop="70dp"
            android:hint="Mood rate"
            android:inputType="text"
            app:layout_constraintStart_toStartOf="@id/currentheart_rate"
            app:layout_constraintTop_toBottomOf="@id/currentheart_rate" />


        <TextView
            android:id="@+id/Sleep_data"
            android:textStyle="bold"
            android:layout_width="250dp"
            android:layout_height="40dp"
            android:layout_marginTop="50dp"
            android:hint="Sleep data"
            android:inputType="text"
            app:layout_constraintStart_toStartOf="@+id/Mood_rate"
            app:layout_constraintTop_toBottomOf="@+id/Mood_rate" />


        <TextView
            android:id="@+id/Activity"
            android:textStyle="bold"
            android:layout_width="250dp"
            android:layout_height="40dp"
            android:layout_marginTop="50dp"
            android:hint="Normal Vital Signs activity"
            android:inputType="text"
            app:layout_constraintStart_toStartOf="@+id/Sleep_data"
            app:layout_constraintTop_toBottomOf="@+id/Sleep_data" />


        <TextView
            android:id="@+id/Treshold"
            android:textStyle="bold"
            android:layout_width="250dp"
            android:layout_height="40dp"
            android:layout_marginTop="50dp"
            android:hint="Treshold Other Vital Sign"
            android:inputType="text"
            app:layout_constraintStart_toStartOf="@+id/Activity"
            app:layout_constraintTop_toBottomOf="@+id/Activity" />


        <TextView
            android:id="@+id/Fall"
            android:textStyle="bold"
            android:layout_width="250dp"
            android:layout_height="40dp"
            android:layout_marginTop="50dp"
            android:hint="Fall detection"
            android:inputType="text"
            app:layout_constraintStart_toStartOf="@+id/Treshold"
            app:layout_constraintTop_toBottomOf="@+id/Treshold" />



    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>