<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/backgroud"
        tools:context=".Patients_RegScreen">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>


        <TextView
            android:id="@+id/title_newuser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Patient's Registration"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/ContainerComponents"
            style="@style/ContainerComponents"
            android:layout_width="0dp"
            android:layout_height="619dp"
            android:layout_marginTop="20dp"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_newuser"
            app:layout_constraintBottom_toTopOf="@id/bt_register"
            app:layout_constraintEnd_toEndOf="parent" />


        <EditText
            android:id="@+id/edit_name"
            style="@style/Edit_Text"
            android:hint="Name:"
            android:textColor="@color/black"
            android:padding="10dp"
            android:inputType="text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ContainerComponents" />

        <EditText
            android:id="@+id/edit_surname"
            style="@style/Edit_Text"
            android:hint="Surname:"
            android:padding="10dp"
            android:inputType="text"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/edit_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />
        <EditText
            android:id="@+id/edit_Mobile"
            style="@style/Edit_Text"
            android:hint="Mobile Number:"
            android:padding="10dp"
            android:textColor="@color/black"
            android:inputType="number"
            android:maxLength="10"
            app:layout_constraintTop_toBottomOf="@id/edit_surname"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <EditText
            android:id="@+id/edit_Patient_Doctors_Name"
            style="@style/Edit_Text"
            android:hint="Patient's Doctor's Name:"
            android:padding="10dp"
            android:inputType="text"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/edit_Mobile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />
        <EditText
            android:id="@+id/edit_Patient_Doctors_Surname"
            style="@style/Edit_Text"
            android:hint="Patient's Doctor's Surname:"
            android:padding="10dp"
            android:textColor="@color/black"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/edit_Patient_Doctors_Name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />
        <EditText
            android:id="@+id/edit_Patient_Caregiver_Name"
            style="@style/Edit_Text"
            android:hint="Caregiver Name and Surname:"
            android:padding="10dp"
            android:inputType="text"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/edit_Patient_Doctors_Surname"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/textViewError2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF0000"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/edit_Patient_Caregiver_Name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <EditText
            android:id="@+id/edit_DOB"
            style="@style/Edit_Text"
            android:layout_marginTop="25dp"
            android:focusable="false"
            android:hint="Date of Birthday (MM dd, yyyy):"
            android:inputType="date"
            android:onClick="showDatePickerDialog"
            android:padding="10dp"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edit_Patient_Caregiver_Name" />

        <EditText
            android:id="@+id/edit_email"
            style="@style/Edit_Text"
            android:hint="EMAIL:"
            android:padding="10dp"
            android:textColor="@color/black"
            android:inputType="textEmailAddress"
            app:layout_constraintTop_toBottomOf="@id/edit_DOB"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />
        <EditText
            android:id="@+id/edit_Password2"
            style="@style/Edit_Text"
            android:hint="Password:"
            android:padding="10dp"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/edit_email"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />
        <EditText
            android:id="@+id/edit_Re_type"
            style="@style/Edit_Text"
            android:hint="Re-type Password:"
            android:padding="8dp"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/edit_Password2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/bt_register"
            style="@style/Button"
            android:text="Register"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/ContainerComponents"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />




    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

